# ─── Application ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────
POSTGRES_USER=autodev
POSTGRES_PASSWORD=autodev_secret
POSTGRES_DB=autodev_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://autodev:autodev_secret@postgres:5432/autodev_db

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── GitHub ────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_REPLACE_ME

# ─── Anthropic ─────────────────────────────────────────────────
# Create at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ─── Sandbox (Docker) ──────────────────────────────────────────
# Resource limits for ephemeral sandbox containers
SANDBOX_CPU_QUOTA=50000          # 50% of one CPU core (docker --cpu-quota)
SANDBOX_MEMORY_LIMIT=512m        # max memory per sandbox
SANDBOX_TIMEOUT_SECONDS=300      # 5 minute hard timeout per sandbox operation
SANDBOX_NETWORK=sandbox_net      # isolated docker network name

# ─── Safety ────────────────────────────────────────────────────
# When true, all GitHub write operations (branch/commit/PR) require
# explicit confirmation before executing — keeps you safe in dev
REQUIRE_GH_CONFIRMATION=true
AUTO_PUSH_TO_GITHUB=false
