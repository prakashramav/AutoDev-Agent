# ─── Local dev .env (no Docker) ────────────────────────────────────────────────
# Uses SQLite instead of Postgres and fakeredis instead of Redis
APP_ENV=development
LOG_LEVEL=INFO

# SQLite — file created automatically in backend/
DATABASE_URL=sqlite+aiosqlite:///./autodev_dev.db

# Fakeredis — no server needed (handled in core/database_dev.py)
REDIS_URL=redis://localhost:6379/0

# Leave blank for Phase 1-2 (no LLM calls yet)
GITHUB_TOKEN=
ANTHROPIC_API_KEY=

# Sandbox — use "bridge" (Docker's default) since we're not enforcing isolation locally
SANDBOX_CPU_QUOTA=50000
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_NETWORK=bridge
SANDBOX_IMAGE=python:3.12-slim

# Safety
REQUIRE_GH_CONFIRMATION=true
AUTO_PUSH_TO_GITHUB=false
